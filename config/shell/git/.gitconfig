; ═════════════════════════════════════════════════════════════════════════════
; Identity
; ═════════════════════════════════════════════════════════════════════════════

[user]
    name = Mohammed Fareed
    email = mohdf.fareed@icloud.com

; ═════════════════════════════════════════════════════════════════════════════
; Settings
; ═════════════════════════════════════════════════════════════════════════════

[init]
    defaultBranch = main
[core]
    excludesfile = ~/.gitignore
    autocrlf = input ; normalize line endings to LF on commit

; git commands
[fetch]
    prune = true ; remove stale remote-tracking branches
[push]
    followTags = true ; push tags when pushing branches
[pull]
    rebase = true ; rebase automatically on pull
[merge]
    autostash = true ; automatically stash before merge
    conflictStyle = zdiff3 ; show original in conflicts and minimize markers
[rerere]
    enabled = true ; remember conflict resolutions
[status]
    short = true ; show short status by default
[help]
    autoCorrect = prompt ; prompt the user to correct typos

; ═════════════════════════════════════════════════════════════════════════════
; Extras
; ═════════════════════════════════════════════════════════════════════════════

; lfs (large file system)
[filter "lfs"]
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f

; zed editor
[core]
    editor = zed --wait
[diff]
    tool = zed
[difftool "zed"]
    cmd = zed --wait --diff $LOCAL $REMOTE
[merge]
    tool = zed
[mergetool "zed"]
    cmd = zed --wait $MERGED

; ═════════════════════════════════════════════════════════════════════════════
; Infrastructure
; ═════════════════════════════════════════════════════════════════════════════

; platform, optional integration, and machine overrides
[include]
    path = ~/.config/git/config.win
[include]
    path = ~/.config/git/config.1pass
[include]
    path = ~/.config/git/config.mc
