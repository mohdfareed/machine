// Example/default ACLs for unrestricted connections.
{
    // Define the tailnet access control policies.
    "grants": [
        // Owner can access everything on the tailnet.
        {
            "src": ["autogroup:owner"],
            "dst": ["*"],
            "ip": ["*"],
        },

        // Shared users can access any port on devices shared with them.
        {
            "src": ["autogroup:shared"],
            "dst": ["*"],
            "ip": ["*"],
        },

        // Allow secure cross-container communication.
        {
            "src": ["tag:container"],
            "dst": ["tag:container"],
            "ip": ["tcp:443"],
        },

        // Family members can access media containers.
        {
            "src": ["group:family"],
            "dst": ["autogroup:internet"],
            "ip": ["*"],
        },

        // Family members can use exit nodes.
        {
            "src": ["group:family"],
            "dst": ["tag:media"],
            "ip": ["tcp:443"],
        },
    ],

    // Define users and devices that can use Tailscale SSH.
    "ssh": [
        // Allow all users to SSH into their own devices in check mode.
        // Comment this section out if you want to define specific restrictions.
        {
            "action": "check",
            "src": ["autogroup:member"],
            "dst": ["autogroup:self"],
            "users": ["autogroup:nonroot", "root"],
        },
    ],

    // Test access rules every time they're saved.
    // "tests": [
    //   {
    //       "src": "alice@example.com",
    //       "accept": ["tag:example"],
    //       "deny": ["100.101.102.103:443"],
    //   },
    // ],

    // Define user groups and their users.
    "groups": { "group:family": ["chroe4euqhs@gmail.com"] },

    // Define device tags and assign to users.
    "tagOwners": {
        "tag:container": ["autogroup:admin"],
        "tag:media": ["autogroup:admin"],
    },

    // Define node attributes and assign to users or devices.
    "nodeAttrs": [
        // Allow admin users to enable Tailscale Funnel.
        {
            "target": ["autogroup:admin"],
            "attr": ["funnel"],
        },

        // Allow Home Lab containers to enable Tailscale Funnel.
        {
            "target": ["tag:container"],
            "attr": ["funnel"],
        },
    ],
}
