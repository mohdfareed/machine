{
  // ==========================================================================
  // MARK: Workspace
  // ==========================================================================
  "cli_default_open_behavior": "new_window",
  "title_bar": {
    "show_menus": true,
    "show_branch_status_icon": true,
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },
  // Panels
  "project_panel": {
    "dock": "left",
    "git_status_indicator": true,
    "diagnostic_badges": true,
  },
  "outline_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
    "group_by": "staging",
    "tree_view": true,
    "file_icons": true,
  },
  "debugger": {
    "dock": "left",
  },
  // ==========================================================================
  // MARK: Appearance
  // ==========================================================================
  "colorize_brackets": true,
  "indent_guides": {
    "coloring": "indent_aware",
  },
  // Theme
  "icon_theme": "Material Icon Theme",
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark Pro",
  },
  // Font
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 14,
  "ui_font_size": 14,
  // ==========================================================================
  // MARK: Editor
  // ==========================================================================
  "vim_mode": false,
  "relative_line_numbers": "disabled",
  "show_whitespaces": "trailing",
  "redact_private_values": true,
  "minimap": {
    "max_width_columns": 120,
    "show": "auto",
  },
  "which_key": {
    "enabled": true,
  },
  // Line Wrapping
  "soft_wrap": "editor_width",
  "preferred_line_length": 120,
  "wrap_guides": [80, 120],
  // Formatting
  "format_on_save": "on",
  "prettier": {
    "allowed": true,
  },
  // Terminal
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
    "font_size": 14,
    "cursor_shape": "bar",
    "option_as_meta": true,
  },
  // ==========================================================================
  // MARK: Intellisense
  // ==========================================================================
  "auto_install_extensions": {
    "typos": true,
  },
  "semantic_tokens": "combined",
  "document_symbols": "on",
  "document_folding_ranges": "on",
  "code_lens": "menu",
  "completion_menu_item_kind": "symbol",
  "global_lsp_settings": {
    "semantic_token_rules": [
      {
        // comments highlighter extension
        "token_type": "comment",
      },
    ],
  },
  "inlay_hints": {
    "toggle_on_modifiers_press": {
      "control": true,
    },
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  // ==========================================================================
  // MARK: Languages
  // ==========================================================================
  "languages": {
    "Python": {
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
      },
    },
    "JSON": {
      "tab_size": 2,
    },
    "JSONC": {
      "tab_size": 2,
    },
    "Markdown": {
      "tab_size": 2,
    },
    "Shell Script": {
      "tab_size": 2,
    },
    "YAML": {
      "tab_size": 2,
    },
  },
  // ==========================================================================
  // MARK: Version Control
  // ==========================================================================
  "diff_view_style": "unified",
  "git": {
    "inline_blame": {
      "location": "status_bar",
      "show_commit_summary": true,
    },
  },
  // ==========================================================================
  // MARK: Remote Dev
  // ==========================================================================
  "ssh_connections": [
    {
      "host": "homelab",
      "args": [],
      "projects": [
        {
          "paths": ["~"],
        },
      ],
    },
    {
      "host": "pc",
      "args": [],
      "projects": [
        {
          "paths": ["~"],
        },
      ],
    },
  ],
  "calls": {
    "mute_on_join": true,
  },
  // ==========================================================================
  // MARK: Agents
  // ==========================================================================
  "show_edit_predictions": true,
  "edit_predictions": {
    "provider": "copilot",
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
    "gemini": {
      "type": "registry",
    },
    "github-copilot-cli": {
      "type": "registry",
    },
  },
  "agent": {
    "dock": "right",
    "show_turn_stats": true,
    "play_sound_when_agent_done": "when_hidden",
    "commit_message_instructions": "Follow conventions and best practices.",
    "default_profile": "write",
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-6-astra",
      "enable_thinking": true,
      "effort": "medium",
      "speed": "standard",
    },
    "profiles": {
      "autopilot": {
        "name": "Autopilot",
        "enable_all_context_servers": true,
        "tools": {
          "write_file": true,
          "terminal": true,
          "spawn_agent": true,
          "skill": true,
          "read_file": true,
          "move_path": true,
          "list_directory": true,
          "grep": true,
          "find_path": true,
          "fetch": true,
          "edit_file": true,
          "diagnostics": true,
          "delete_path": true,
          "create_directory": true,
          "copy_path": true,
          "ask_user": true,
        },
      },
    },
    // ========================================================================
    // MARK: Permissions
    // ========================================================================
    "sandbox_permissions": {
      "allow_all_hosts": true,
      "write_paths": [],
    },
    "tool_permissions": {
      "tools": {
        "fetch": {
          "always_allow": [
            {
              "pattern": "^https://", // allow all secure http
            },
          ],
        },
        "terminal": {
          "default": "allow",
          "always_confirm": [
            {
              "pattern": "^(sudo|docker|ssh|scp|rsync)\\b",
            },
          ],
        },
      },
    },
  },
  // ==========================================================================
  // MARK: MCP Servers
  // ==========================================================================
  "context_servers": {
    "craft-docs": {
      "url": "https://mcp.craft.do/links/Ll1BPMqendN/mcp",
    },
    "craft-docs-all": {
      "url": "https://mcp.craft.do/links/jbeCfIXlpx/mcp",
    },
  },
}
