; =============================================================================
; Identity
; =============================================================================

[user]
    name = Mohammed Fareed
    email = mohdf.fareed@icloud.com

; sign commits
[user]
    signingkey = ~/.ssh/personal.pub
[commit]
    gpgsign = true
[gpg]
    format = ssh ; use ssh key for signing

; =============================================================================
; Settings
; =============================================================================

; git settings
[init]
    defaultBranch = main
[core]
    excludesfile = ~/.gitignore
    autocrlf = input ; normalize line endings to LF on commit

; git commands
[fetch]
    prune = true ; remove stale remote-tracking branches
[pull]
    rebase = true
[merge]
    autostash = true ; automatically stash before merge
[rerere]
    enabled = true ; remember conflict resolutions
[status]
    short = true
[help]
    autoCorrect = prompt

; lfs (large file system)
[filter "lfs"]
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f

; =============================================================================
; Editor
; =============================================================================

; zed editor
[core]
    editor = zed --wait
[diff]
    tool = zed
[difftool "zed"]
    cmd = zed --wait --diff $LOCAL $REMOTE
[merge]
    tool = zed
[mergetool "zed"]
    cmd = zed --wait $MERGED

; =============================================================================
; Infrastructure
; =============================================================================

; platform and machine overrides
[include]
    path = ~/.gitconfig.win
[include]
    path = ~/.gitconfig.mc
