; ═════════════════════════════════════════════════════════════════════════════
; Identity
; ═════════════════════════════════════════════════════════════════════════════

[user]
    name = Mohammed Fareed
    email = mohdf.fareed@icloud.com

; sign commits
[user]
    signingkey = ~/.ssh/machine.pub
[commit]
    gpgsign = true
[gpg]
    format = ssh ; use ssh key for signing

; ═════════════════════════════════════════════════════════════════════════════
; Settings
; ═════════════════════════════════════════════════════════════════════════════

; git settings
[init]
    defaultBranch = main
[core]
    excludesfile = ~/.gitignore
    autocrlf = input ; normalize line endings to LF on commit
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true ; navigate with n|N
    line-numbers = true
    side-by-side = false

; git commands
[fetch]
    prune = true ; remove stale remote-tracking branches
[pull]
    rebase = true ; rebase automatically on pull
[merge]
    autostash = true ; automatically stash before merge
    conflictStyle = zdiff3 ; show original in conflicts and minimize markers
[rerere]
    enabled = true ; remember conflict resolutions
[status]
    short = true ; show short status by default
[help]
    autoCorrect = prompt ; prompt the user to correct typos

; lfs (large file system)
[filter "lfs"]
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f

; ═════════════════════════════════════════════════════════════════════════════
; Editor
; ═════════════════════════════════════════════════════════════════════════════

; zed editor
[core]
    editor = zed --wait
[diff]
    tool = zed
[difftool "zed"]
    cmd = zed --wait --diff $LOCAL $REMOTE
[merge]
    tool = zed
[mergetool "zed"]
    cmd = zed --wait $MERGED

; ═════════════════════════════════════════════════════════════════════════════
; Infrastructure
; ═════════════════════════════════════════════════════════════════════════════

; platform and machine overrides
[include]
    path = ~/.gitconfig.win
[include]
    path = ~/.gitconfig.mc
