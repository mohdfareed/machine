{
  "lsp": {
    "markdownlint": {
      "settings": {
        "MD013": false, // disable 80 char line length limit
      },
    },
  },
  "file_scan_exclusions": [
    "**/.DS_Store",
    "**/.git",
    "**/__pycache__",
    "**/.pytest_cache",
    "**/.ruff_cache",
    "**/.uv-cache",
  ],
  // file associations
  "file_types": {
    "JSONC": ["**/zed/settings.json", "**/vscode/settings.json", ".code-snippets"],
    "ini": ["**/ssh/client/config*", ".config", ".ghostty"],
    "Git Config": [".gitconfig*", "**/git/config*"],
    "Env": [".env*"],
    "Shell Script": ["mc"],
  },
}
