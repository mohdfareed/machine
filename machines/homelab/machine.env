# Homelab machine env vars (sourced by .zshenv after ~/.env).
ICLOUD="$HOME/Library/Mobile Documents/com~apple~CloudDocs"
MC_PRIVATE="$ICLOUD/.machine"
MC_HOMELAB_DIR="$HOME/.homelab"
HOMELAB_TIMEZONE=America/New_York
HOMEPAGE_TITLE="Homelab"
HOMEPAGE_FAVICON="mdi-home-analytics"
HOMELAB_MEDIA_DIR="$MC_HOMELAB_DIR/storage/media"
GODOT="/Applications/Godot_mono.app/Contents/MacOS/Godot"
