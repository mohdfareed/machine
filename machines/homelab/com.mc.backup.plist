<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mc.backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>source "$HOME/.zshenv" 2>/dev/null; exec "$MC_HOME/machines/$MC_ID/scripts/_backup.sh"</string>
    </array>

    <!-- Run daily at 04:30 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/mc-backup.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/mc-backup.log</string>

    <key>RunAtLoad</key>
    <false />
</dict>
</plist>
